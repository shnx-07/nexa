[Desktop Entry]
Name=Yazi
GenericName=File Manager
Comment=Blazing fast terminal file manager written in Rust
Icon=yazi
Type=Application
Categories=System;FileTools;FileManager;
MimeType=inode/directory;
Exec=kitty --class yazi -e yazi %u
Terminal=false
StartupWMClass=yazi
Keywords=File;Manager;Explorer;Browser;
