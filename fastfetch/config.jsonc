{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch",
        "padding": {
            "top": 1,
            "right": 3
        }
    },
    "display": {
        "separator": "  󰅂  ",
        "color": {
            "separator": "blue"
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "  {#34} {user-name}{#}  󰇅  {#36}{host-name}{#}"
        },
        {
            "type": "custom",
            "format": "  ──────────────────────────────────────────"
        },
        {
            "type": "os",
            "key": "  󰣇  OS      ",
            "keyColor": "cyan",
            "format": "Arch Linux {arch}"
        },
        {
            "type": "kernel",
            "key": "  󰌽  Kernel  ",
            "keyColor": "cyan"
        },
        {
            "type": "uptime",
            "key": "  󰅐  Uptime  ",
            "keyColor": "cyan"
        },
        {
            "type": "packages",
            "key": "  󰏖  Packages",
            "keyColor": "cyan"
        },
        {
            "type": "shell",
            "key": "    Shell   ",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "  󰨇  WM      ",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "    Terminal",
            "keyColor": "blue"
        },
        {
            "type": "theme",
            "key": "  󰉼  Theme   ",
            "keyColor": "blue"
        },
        {
            "type": "cpu",
            "key": "  󰍛  CPU     ",
            "keyColor": "magenta"
        },
        {
            "type": "gpu",
            "key": "  󰢮  GPU     ",
            "keyColor": "magenta"
        },
        {
            "type": "memory",
            "key": "  󰑭  Memory  ",
            "keyColor": "magenta"
        },
        {
            "type": "disk",
            "key": "  󰋊  Disk    ",
            "keyColor": "magenta",
            "folders": "/"
        },
        {
            "type": "battery",
            "key": "  󱊣  Battery ",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": "  ──────────────────────────────────────────"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        },
        "break"
    ]
}
