# NEXA generated btop theme
# Do not edit manually.

# Main background, empty for terminal default
theme[main_bg]=#20181a

# Main text color
theme[main_fg]=#e7dadd

# Title color for boxes
theme[title]=#ffb599

# Highlight color for keyboard shortcuts
theme[hi_fg]=#ffb599

# Background color of selected item in processes box
theme[selected_bg]=#7f2b00

# Foreground color of selected item in processes box
theme[selected_fg]=#ffdbce

# Color of inactive/disabled text
theme[inactive_fg]=#84626a

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]=#c2adb2

# Background color of the percentage meters
theme[meter_bg]=#4c343a

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]=#f0be79

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]=#ffb599
theme[mem_box]=#f0bc95
theme[net_box]=#79cfec
theme[proc_box]=#f0be79

# Box divider line and small boxes line color
theme[div_line]=#422e33

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]=#78e29c
theme[temp_mid]=#efc36c
theme[temp_end]=#f0757f

# CPU graph colors
theme[cpu_start]=#ffb599
theme[cpu_mid]=#f0bc95
theme[cpu_end]=#f0be79

# Mem/Disk free meter
theme[free_start]=#78e29c
theme[free_mid]=#79cfec
theme[free_end]=#ffb599

# Mem/Disk cached meter
theme[cached_start]=#79cfec
theme[cached_mid]=#ffb599
theme[cached_end]=#f0bc95

# Mem/Disk available meter
theme[available_start]=#78e29c
theme[available_mid]=#efc36c
theme[available_end]=#ffb599

# Mem/Disk used meter
theme[used_start]=#ffb599
theme[used_mid]=#efc36c
theme[used_end]=#f0757f

# Download graph colors
theme[download_start]=#79cfec
theme[download_mid]=#ffb599
theme[download_end]=#f0be79

# Upload graph colors
theme[upload_start]=#f0be79
theme[upload_mid]=#f0bc95
theme[upload_end]=#ffb599

# Process box color gradient for threads, mem and cpu usage
theme[process_start]=#78e29c
theme[process_mid]=#efc36c
theme[process_end]=#f0757f

# Process box status banners
theme[proc_banner_fg]=#ffdbce
theme[proc_banner_bg]=#7f2b00
theme[proc_follow_bg]=#ffb599
theme[proc_pause_bg]=#efc36c
theme[followed_fg]=#5a1c00
theme[followed_bg]=#ffb599
