# NEXA generated htoprc configuration
# Do not edit manually.

fields=0 48 17 18 38 39 40 2 46 47 49 1
sort_key=46
sort_direction=-1
tree_sort_key=0
tree_sort_direction=1
hide_kernel_threads=1
hide_userland_threads=0
shadow_other_users=0
show_thread_names=0
show_program_path=1
highlight_base_name=0
highlight_deleted_exe=1
highlight_megabytes=1
highlight_threads=1
highlight_changes=0
highlight_changes_delay_secs=5
find_comm_in_cmdline=1
strip_exe_from_cmdline=1
show_merged_command=0
tree_view=0
tree_view_always_by_pid=0
all_branches_collapsed=0
header_margin=1
detailed_cpu_time=0
cpu_count_from_one=0
show_cpu_usage=1
show_cpu_frequency=0
show_cpu_temperature=0
degree_fahrenheit=0
update_process_names=0
account_guest_in_cpu_meter=0
color_scheme=6

# Custom color definitions
# Main interface colors
color_background={{colors.background}}
color_text={{colors.on_surface}}
color_highlight={{colors.primary}}
color_selected={{colors.primary_container}}

# CPU meter colors (gradient)
color_cpu_low={{colors.success}}
color_cpu_med={{colors.warning}}
color_cpu_high={{colors.error}}

# Memory meter colors
color_mem_used={{colors.primary}}
color_mem_buffers={{colors.secondary}}
color_mem_cache={{colors.tertiary}}
color_mem_available={{colors.success}}

# Process list colors
color_process_normal={{colors.on_surface}}
color_process_running={{colors.success}}
color_process_sleeping={{colors.outline}}
color_process_zombie={{colors.error}}
color_process_stopped={{colors.warning}}

# Header and border colors
color_header={{colors.on_surface_variant}}
color_border={{colors.outline}}
color_separator={{colors.outline_variant}}

# Function key colors
color_function_key={{colors.primary}}
color_function_desc={{colors.on_surface}}

# Tree view colors
color_tree_line={{colors.outline}}
color_tree_collapsed={{colors.primary}}
color_tree_expanded={{colors.secondary}}

# Load average colors
color_load_low={{colors.success}}
color_load_med={{colors.warning}}
color_load_high={{colors.error}}

# Priority colors
color_priority_high={{colors.error}}
color_priority_normal={{colors.on_surface}}
color_priority_low={{colors.outline}}

# Swap meter colors
color_swap_used={{colors.tertiary}}
color_swap_cache={{colors.secondary}}

# Temperature colors
color_temp_cool={{colors.success}}
color_temp_warm={{colors.warning}}
color_temp_hot={{colors.error}}
