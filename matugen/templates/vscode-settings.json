{
    "workbench.colorTheme": "Default Dark Modern",
    "workbench.iconTheme": "material-icon-theme",
    "diffEditor.maxComputationTime": 0,
    "workbench.colorCustomizations": {
        "focusBorder": "{{colors.primary}}",
        "activityBar.background": "{{colors.surface_container_lowest}}",
        "activityBar.foreground": "{{colors.primary}}",
        "activityBar.inactiveForeground": "{{colors.on_surface_variant}}",
        "activityBarBadge.background": "{{colors.primary}}",
        "activityBarBadge.foreground": "{{colors.on_primary}}",
        "sideBar.background": "{{colors.surface_container_low}}",
        "sideBar.foreground": "{{colors.on_surface}}",
        "sideBarTitle.foreground": "{{colors.on_surface}}",
        "sideBarSectionHeader.background": "{{colors.surface_container}}",
        "sideBarSectionHeader.foreground": "{{colors.primary}}",
        "editorGroupHeader.tabsBackground": "{{colors.surface_container_low}}",
        "tab.activeBackground": "{{colors.background}}",
        "tab.activeForeground": "{{colors.primary}}",
        "tab.activeBorderTop": "{{colors.primary}}",
        "tab.inactiveBackground": "{{colors.surface_container_low}}",
        "tab.inactiveForeground": "{{colors.on_surface_variant}}",
        "editor.background": "{{colors.background}}",
        "editor.foreground": "{{colors.on_background}}",
        "editorLineNumber.foreground": "{{colors.outline_variant}}",
        "editorLineNumber.activeForeground": "{{colors.primary}}",
        "editorCursor.foreground": "{{colors.primary}}",
        "editor.selectionBackground": "{{colors.primary_container}}60",
        "editor.lineHighlightBackground": "{{colors.surface_container_low}}40",
        "statusBar.background": "{{colors.surface_container_lowest}}",
        "statusBar.foreground": "{{colors.on_surface}}",
        "statusBarItem.remoteBackground": "{{colors.primary}}",
        "statusBarItem.remoteForeground": "{{colors.on_primary}}",
        "titleBar.activeBackground": "{{colors.surface_container_lowest}}",
        "titleBar.activeForeground": "{{colors.on_surface}}",
        "titleBar.inactiveBackground": "{{colors.surface_container_lowest}}",
        "titleBar.inactiveForeground": "{{colors.on_surface_variant}}",
        "list.activeSelectionBackground": "{{colors.primary_container}}",
        "list.activeSelectionForeground": "{{colors.on_primary_container}}",
        "list.hoverBackground": "{{colors.surface_container}}",
        "button.background": "{{colors.primary}}",
        "button.foreground": "{{colors.on_primary}}",
        "input.background": "{{colors.surface_container}}",
        "input.foreground": "{{colors.on_surface}}",
        "input.border": "{{colors.outline_variant}}",
        "terminal.background": "{{colors.background}}",
        "terminal.foreground": "{{colors.on_background}}",
        "terminal.ansiBlack": "{{colors.surface}}",
        "terminal.ansiRed": "{{colors.error}}",
        "terminal.ansiGreen": "{{colors.success}}",
        "terminal.ansiYellow": "{{colors.warning}}",
        "terminal.ansiBlue": "{{colors.primary}}",
        "terminal.ansiMagenta": "{{colors.tertiary}}",
        "terminal.ansiCyan": "{{colors.info}}",
        "terminal.ansiWhite": "{{colors.on_surface}}",
        "terminal.ansiBrightBlack": "{{colors.outline}}",
        "terminal.ansiBrightRed": "{{colors.error}}",
        "terminal.ansiBrightGreen": "{{colors.success}}",
        "terminal.ansiBrightYellow": "{{colors.warning}}",
        "terminal.ansiBrightBlue": "{{colors.primary}}",
        "terminal.ansiBrightMagenta": "{{colors.tertiary}}",
        "terminal.ansiBrightCyan": "{{colors.info}}",
        "terminal.ansiBrightWhite": "{{colors.on_background}}"
    }
}

