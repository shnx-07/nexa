#!/usr/bin/env bash
# If already in an interactive terminal, run CLI directly
if [ -t 0 ] && [ -t 1 ]; then
    exec /usr/bin/yazi "$@"
else
    # If launched from GUI/Hyprland/runners, launch in terminal with class yazi for Hyprland window rules
    target="${1:-$HOME}"
    if command -v kitty >/dev/null 2>&1; then
        exec kitty --class yazi --directory "$target" yazi "$target"
    elif command -v alacritty >/dev/null 2>&1; then
        exec alacritty --class yazi --working-directory "$target" -e yazi "$target"
    else
        cd "$target" && exec /usr/bin/yazi "$target"
    fi
fi
